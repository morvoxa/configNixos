configuration {
    /* Basic Mode and Display */
    modi: "drun,run,window";
    font: "JetBrainsMono Nerd Font 14";
    show-icons: true;
    icon-theme: "Papirus";
    /* Menggunakan simbol Nerd Font untuk ikon kategori */
    display-drun: "Apps:";
    display-run: "Run:";
    display-window: "󱂬 Window:";
    drun-display-format: "{name}";
    sip-keyboard: false;
}


/* Theme Customization & Balanced Proportions */
* {
    bg0: #1a1b26;
    bg1: #24283b;
    bg2: #414868;
    fg0: #c0caf5;
    fg1: #7aa2f7;
    accent: #7dcfff;
    
    background-color: transparent;
    text-color: @fg0;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    /* Balanced size */
    width: 650px;
    height: 450px;
    x-offset: 0px;
    y-offset: 0px;

    background-color: @bg0;
    border: 2px;
    border-color: @accent;
    /* Full rounded corners ala macOS Spotlight */
    border-radius: 24px;
}

mainbox {
    spacing: 15px;
    padding: 25px;
    background-color: @bg0;
    children: [ inputbar, message, listview ];
}

/* Search Bar with Full Rounded Corners */
inputbar {
    spacing: 12px;
    padding: 15px 20px;
    background-color: @bg1;
    /* Full rounded corners on the input box */
    border-radius: 20px;
    border: 1px;
    border-color: @bg2;
    children: [ prompt, entry ];
}

prompt {
    enabled: true;
    font: "JetBrainsMono Nerd Font Bold 14";
    text-color: @accent;
    background-color: transparent;
}

entry {
    font: "JetBrainsMono Nerd Font 14"; /* Large search font */
    placeholder: "Type to search applications...";
    placeholder-color: @bg2;
    text-color: @fg0;
    background-color: transparent;
}

/* Balanced and Clean Listview */
listview {
    enabled: true;
    columns: 1;
    lines: 6; /* Balanced item rows */
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    
    spacing: 8px;
    background-color: @bg0;
}

element {
    enabled: true;
    padding: 10px 15px;
    /* Rounded items inside the list */
    border-radius: 12px;
    /* Konsisten gelap menggunakan bg0 */
    background-color: @bg0;
    text-color: @fg0;
    cursor: pointer;
}

element normal.normal {
    background-color: @bg0;
    text-color: @fg0;
}

element alternate.normal {
    background-color: @bg0;
    text-color: @fg0;
}

element selected.normal {
    background-color: @bg1;
    text-color: @fg1;
    border: 1px;
    border-color: @accent;
}

element-icon {
    size: 24px;
    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.0;
    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 12";
}
